{
  "name": "pouchdb-adapter-react-native-sqlite",
  "version": "4.4.2",
  "description": "PouchDB adapter for React Native SQLite",
  "keywords": [
    "android",
    "ios",
    "react-native"
  ],
  "homepage": "https://github.com/craftzdog/pouchdb-adapter-react-native-sqlite#readme",
  "bugs": {
    "url": "https://github.com/craftzdog/pouchdb-adapter-react-native-sqlite/issues"
  },
  "license": "MIT",
  "author": "Takuya Matsuyama <hi@craftz.dog> (https://github.com/craftzdog)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/craftzdog/pouchdb-adapter-react-native-sqlite.git"
  },
  "source": "./src/index.ts",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "exports": {
    ".": {
      "pouchdb-adapter-react-native-sqlite-source": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "example": "pnpm --filter pouchdb-adapter-react-native-sqlite-example",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && pnpm example run typecheck",
    "lint": "oxlint",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "release": "release-it",
    "format": "oxfmt"
  },
  "dependencies": {
    "@craftzdog/react-native-buffer": "^6.1.2",
    "@op-engineering/op-sqlite": "^18.2.3",
    "debug": "^4.4.3",
    "events": "^3.3.0",
    "pouchdb-adapter-utils": "^9.0.0",
    "pouchdb-errors": "^9.0.0",
    "pouchdb-json": "^9.0.0",
    "pouchdb-merge": "^9.0.0",
    "pouchdb-utils": "^9.0.0",
    "react-native-quick-base64": "^3.0.1"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^17.0.2",
    "@craftzdog/pouchdb-errors": "^9.0.1",
    "@evilmartians/lefthook": "^1.5.0",
    "@nkzw/oxlint-config": "^3.0.1",
    "@react-native-community/cli": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@release-it/conventional-changelog": "^9.0.2",
    "@types/debug": "^4.1.13",
    "@types/pouchdb-core": "^7.0.15",
    "@types/react": "^19.2.0",
    "commitlint": "^17.0.2",
    "del-cli": "^5.1.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.94.0",
    "oxlint-plugin-react-native": "^0.2.44",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.44.0",
    "release-it": "^17.10.0",
    "tsrs": "7.1.0-beta.tsrs5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vitest-native": "^0.15.1"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "pnpm@12.21.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  }
}
